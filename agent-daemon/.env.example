# --- Connection ---
# Base URL of the Hub API. The daemon connects to `${HUB_URL}/daemon`.
HUB_URL=http://localhost:3000

# API key returned by `POST /servers` on the Hub. Required; the Hub rejects
# the socket connection when this does not match a registered server.
API_KEY=

# Local identifier used only for logging (the Hub derives the real server id
# from the API key on the socket handshake).
SERVER_ID=ubuntu-01

# --- Codex / command ---
# Shell-command template used to spawn the agent for each task.
# Supported placeholders:
#   {{prompt}}   -> input.prompt  (raw text, never goes through a shell)
#   {{input}}    -> full task input as JSON
#   {{cwd}}      -> the value of CODEX_EXEC_CWD
# Placeholders inside double quotes are substituted as a single argument.
CODEX_COMMAND_TEMPLATE=codex exec "{{prompt}}"

# Working directory the child process is spawned in. Optional.
# CODEX_EXEC_CWD=/home/user/projects

# Set to 1 to run the command template through the system shell (`spawn shell:true`)
# rather than as a direct argv (default 0). Useful on Windows where the CLI is a
# `.cmd` shim. When enabled, placeholder values are shell-quoted.
# CODEX_USE_SHELL=0

# --- Heartbeat / timing ---
# How often to emit `daemon:heartbeat` (ms). Default 30000.
HEARTBEAT_INTERVAL_MS=30000

# --- Logging ---
# Set to 1 to print daemon-originated socket events to stdout (debug).
DEBUG_SOCKET=0